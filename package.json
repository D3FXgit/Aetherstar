{
  "name": "aetherstar",
  "version": "1.1.1",
  "description": "Party karaoke for UltraStar song libraries",
  "author": "D3X",
  "license": "MIT",
  "homepage": "https://github.com/D3FXgit/AetherStar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D3FXgit/AetherStar.git"
  },
  "bugs": {
    "url": "https://github.com/D3FXgit/AetherStar/issues"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "predev:electron": "npm run build:native && npm run rebuild:electron",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "preview": "vite preview",
    "prestart": "npm run build:native && npm run rebuild:electron",
    "start": "npm run build && cross-env NODE_ENV=production electron .",
    "prepackage": "npm run build:native && npm run rebuild:electron",
    "package": "npm run build && electron-builder --dir",
    "predist": "npm run build:native && npm run rebuild:electron",
    "dist": "npm run build && electron-builder",
    "predist:mac": "npm run build:native && npm run rebuild:electron && node scripts/check-mac-signing.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "predist:win": "npm run build:native && npm run rebuild:electron",
    "dist:win": "npm run build && electron-builder --win",
    "predist:linux": "npm run build:native && npm run rebuild:electron",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:native": "napi build --release --manifest-path native/Cargo.toml --output-dir native",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 && node scripts/copy-native-cache.cjs && npm run rebuild:node",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pretest": "node scripts/ensure-better-sqlite3.cjs",
    "generate:sounds": "node scripts/generate-sound-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-sqlite3": "^11.10.0",
    "framer-motion": "^13.1.1",
    "fuse.js": "^7.5.0",
    "pixi.js": "^8.20.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-easy-crop": "^6.2.3",
    "react-window": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.33.0",
    "@napi-rs/cli": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^25.1.8",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.68.0",
    "vite": "^7.1.2",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.4"
  }
}
